// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Banco: SQLite via Turso (libSQL) — compatível com Vercel serverless.
// Usa o driver adapter @prisma/adapter-libsql para conectar ao Turso.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Score {
  id         String   @id @default(cuid())
  playerName String
  score      Int
  mode       String // "classic" | "classic_wrap" | "special" | "time" | "maze"
  players    Int // 1 | 2
  createdAt  DateTime @default(now())

  @@index([mode, players, score(sort: Desc)])
}
